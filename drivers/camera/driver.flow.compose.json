            "en": "Snapshot",
            "fr": "Instantané",
            "nl": "Momentopname"
          }
        }
      ]
    },
    {
      "id": "doorbell_pressed",
      "title": {
        "en": "The doorbell is pressed",
        "fr": "La sonnette est actionnée",
        "nl": "Er wordt aangebeld"
      },
      "hint": {
        "en": "Fires when Scrypted reports a doorbell press on this device.",
        "fr": "Se déclenche quand Scrypted signale un appui sur la sonnette de cet appareil.",
        "nl": "Wordt geactiveerd wanneer Scrypted een druk op de deurbel meldt."
      },
      "tokens": [
        {
          "name": "snapshot",
          "type": "image",
          "title": {
            "en": "Snapshot",
            "fr": "Instantané",
            "nl": "Momentopname"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "id": "take_snapshot",
      "title": {
        "en": "Refresh the snapshot",
        "fr": "Actualiser l'instantané",
        "nl": "Momentopname vernieuwen"
      },
      "hint": {
        "en": "Pulls a new still image from the camera and updates the snapshot tile.",
        "fr": "Récupère une nouvelle image de la caméra et met à jour la vignette.",
        "nl": "Haalt een nieuw stilstaand beeld op en werkt de momentopname bij."
      }
    }
  ],
  "conditions": [
    {
      "id": "detected_recently",
      "title": {
        "en": "Something was recorded recently",
        "fr": "Quelque chose a été enregistré récemment",
        "nl": "Er is onlangs iets opgenomen"
      },
      "titleFormatted": {
        "en": "!{{Recorded|Did not record}} [[detection_class]] in the last [[minutes]] minutes",
        "fr": "A !{{enregistré|pas enregistré}} [[detection_class]] dans les [[minutes]] dernières minutes",
        "nl": "Heeft [[detection_class]] de laatste [[minutes]] minuten !{{opgenomen|niet opgenomen}}"
      },
      "hint": {
        "en": "Asks the recorder what it has stored, not this app's own memory, so it still answers correctly after a restart and covers time before the camera was added. Only recognised objects are recorded with a retrievable event; plain motion is not.",
        "fr": "Interroge l'enregistreur sur ce qu'il a stocké, et non la mémoire de cette app : la réponse reste juste après un redémarrage et couvre la période antérieure à l'ajout de la caméra. Seuls les objets reconnus sont enregistrés comme événement récupérable, pas le simple mouvement.",
        "nl": "Vraagt de recorder wat hij heeft opgeslagen, niet het geheugen van deze app, dus het antwoord klopt ook na een herstart en dekt de tijd voordat de camera werd toegevoegd. Alleen herkende objecten worden als opvraagbare gebeurtenis opgeslagen, gewone beweging niet."
      },
      "args": [
        {
          "name": "detection_class",
          "type": "dropdown",
          "title": {
            "en": "Object",
            "fr": "Objet",
            "nl": "Object"
