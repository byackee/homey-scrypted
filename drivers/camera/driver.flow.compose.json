        "en": "[[detection_class]] detected",
        "fr": "Détection : [[detection_class]]",
        "nl": "[[detection_class]] gedetecteerd"
      },
      "hint": {
        "en": "Fires when Scrypted's object detector recognises something on this camera.",
        "fr": "Se déclenche quand le détecteur d'objets de Scrypted reconnaît quelque chose sur cette caméra.",
        "nl": "Wordt geactiveerd wanneer de objectdetectie van Scrypted iets herkent op deze camera."
      },
      "args": [
        {
          "name": "detection_class",
          "type": "dropdown",
          "title": {
            "en": "Object",
            "fr": "Objet",
            "nl": "Object"
          },
          "values": [
            {
              "id": "any",
              "title": {
                "en": "Any object",
                "fr": "N'importe quel objet",
                "nl": "Elk object"
              }
            },
            {
              "id": "person",
              "title": {
                "en": "Person",
                "fr": "Personne",
                "nl": "Persoon"
              }
            },
            {
              "id": "vehicle",
              "title": {
                "en": "Vehicle",
                "fr": "Véhicule",
                "nl": "Voertuig"
              }
            },
            {
              "id": "animal",
              "title": {
                "en": "Animal",
                "fr": "Animal",
                "nl": "Dier"
              }
            },
            {
              "id": "package",
              "title": {
                "en": "Package",
                "fr": "Colis",
                "nl": "Pakket"
              }
            },
            {
              "id": "face",
              "title": {
