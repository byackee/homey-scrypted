  "esm": true,
  "flow": {
    "triggers": [
      {
        "id": "object_detected",
        "title": {
          "en": "An object is detected",
          "fr": "Un objet est détecté",
          "nl": "Een object wordt gedetecteerd"
        },
        "titleFormatted": {
          "en": "!{{[[detection_class]]|Any object}} is detected",
          "fr": "!{{[[detection_class]]|Un objet}} est détecté",
          "nl": "!{{[[detection_class]]|Een object}} wordt gedetecteerd"
        },
        "hint": {
          "en": "Fires when Scrypted's object detector recognises something on this camera.",
          "fr": "Se déclenche quand le détecteur d'objets de Scrypted reconnaît quelque chose sur cette caméra.",
          "nl": "Wordt geactiveerd wanneer de objectdetectie van Scrypted iets herkent op deze camera."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=camera"
          },
          {
            "name": "detection_class",
            "type": "dropdown",
            "title": {
              "en": "Object",
              "fr": "Objet",
              "nl": "Object"
            },
            "values": [
              {
                "id": "any",
                "title": {
                  "en": "Any object",
                  "fr": "N'importe quel objet",
                  "nl": "Elk object"
                }
              },
              {
                "id": "person",
                "title": {
                  "en": "Person",
                  "fr": "Personne",
                  "nl": "Persoon"
                }
              },
              {
                "id": "vehicle",
                "title": {
                  "en": "Vehicle",
                  "fr": "Véhicule",
                  "nl": "Voertuig"
                }
              },
              {
                "id": "animal",
                "title": {
                  "en": "Animal",
                  "fr": "Animal",
                  "nl": "Dier"
                }
              },
              {
                "id": "package",
                "title": {
                  "en": "Package",
                  "fr": "Colis",
                  "nl": "Pakket"
                }
              },
              {
                "id": "face",
                "title": {
                  "en": "Face",
                  "fr": "Visage",
                  "nl": "Gezicht"
                }
              },
              {
                "id": "motion",
                "title": {
                  "en": "Motion",
                  "fr": "Mouvement",
                  "nl": "Beweging"
                }
              }
            ]
          }
        ],
        "tokens": [
          {
            "name": "detection_class",
            "type": "string",
            "title": {
              "en": "Object",
              "fr": "Objet",
              "nl": "Object"
            },
            "example": {
              "en": "person"
            }
          },
          {
            "name": "label",
            "type": "string",
            "title": {
              "en": "Label",
              "fr": "Étiquette",
              "nl": "Label"
            },
            "example": {
              "en": "Alice"
            }
          },
          {
            "name": "score",
            "type": "number",
            "title": {
              "en": "Confidence",
              "fr": "Confiance",
              "nl": "Zekerheid"
            },
            "example": {
              "en": "87"
            }
          },
          {
            "name": "snapshot",
            "type": "image",
            "title": {
              "en": "Snapshot",
              "fr": "Instantané",
              "nl": "Momentopname"
            }
          }
        ]
      },
      {
        "id": "doorbell_pressed",
        "title": {
          "en": "The doorbell is pressed",
          "fr": "La sonnette est actionnée",
          "nl": "Er wordt aangebeld"
